{
  "annotations": {"list": []},
  "editable": true,
  "graphTooltip": 1,
  "panels": [
    {
      "type": "stat",
      "title": "Events / second",
      "id": 1,
      "gridPos": {"h": 8, "w": 6, "x": 0, "y": 0},
      "targets": [{"expr": "sum(rate(telemetry_events_received_total[1m]))", "legendFormat": "accepted"}]
    },
    {
      "type": "stat",
      "title": "Ingest p95",
      "id": 2,
      "gridPos": {"h": 8, "w": 6, "x": 6, "y": 0},
      "fieldConfig": {"defaults": {"unit": "s", "thresholds": {"mode": "absolute", "steps": [{"color": "green"}, {"color": "red", "value": 5}]}}},
      "targets": [{"expr": "histogram_quantile(0.95, sum by (le) (rate(telemetry_ingest_request_seconds_bucket[1m])))", "legendFormat": "p95"}]
    },
    {
      "type": "timeseries",
      "title": "Pipeline queue depth",
      "id": 3,
      "gridPos": {"h": 8, "w": 6, "x": 12, "y": 0},
      "targets": [{"expr": "sum(telemetry_pipeline_queue_depth)", "legendFormat": "queued"}]
    },
    {
      "type": "timeseries",
      "title": "SQL generation latency",
      "id": 4,
      "gridPos": {"h": 8, "w": 6, "x": 18, "y": 0},
      "targets": [{"expr": "rate(telemetry_sql_generation_seconds_sum[1m]) / rate(telemetry_sql_generation_seconds_count[1m])", "legendFormat": "{{cache}}"}]
    }
  ],
  "refresh": "2s",
  "schemaVersion": 38,
  "tags": ["highway9", "telemetry", "gke"],
  "templating": {"list": []},
  "time": {"from": "now-15m", "to": "now"},
  "timezone": "browser",
  "title": "Highway9 Real-Time Telemetry",
  "uid": "highway9-telemetry",
  "version": 1
}
